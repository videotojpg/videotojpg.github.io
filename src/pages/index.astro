---
import Layout from '../layouts/Layout.astro';
import VideoToJpg from '../components/VideoToJpg.jsx';

// Structured data for SEO
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Video to JPG Converter",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "Any (Web Browser)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  
  <div class="space-y-16 py-8">
    {/* Hero Section */}
    <section class="text-center space-y-6 max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Convert Video to Image Frames <span class="text-blue-600 block sm:inline">Locally & Securely</span>
      </h1>
      <p class="text-lg md:text-xl text-slate-600 leading-relaxed">
        Extract high-quality JPG, PNG, or WebP frames from your videos. 100% free, private, and works entirely in your browser with zero server uploads.
      </p>
    </section>

    {/* Main App Interface */}
    <section id="app">
      <VideoToJpg client:load />
    </section>

    {/* Content Sections for SEO */}
    <div class="max-w-4xl mx-auto space-y-16 mt-20 pt-16 border-t border-slate-200">
      
      {/* How To */}
      <section class="space-y-6">
        <h2 class="text-3xl font-bold text-slate-900">How to Convert Video to JPG Image Frames Online</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center shrink-0">1</div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">Upload Video</h3>
              <p class="text-slate-600 text-sm">Upload or drag & drop your video file (up to 100MB).</p>
            </div>
          </div>
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center shrink-0">2</div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">Configure Settings</h3>
              <p class="text-slate-600 text-sm">Select your extraction rate (FPS), quality level, and image format (JPG, PNG, or WebP).</p>
            </div>
          </div>
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center shrink-0">3</div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">Extract Frames</h3>
              <p class="text-slate-600 text-sm">Click 'Extract Frames' and watch the tool process your video locally in real time.</p>
            </div>
          </div>
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center shrink-0">4</div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">Download Images</h3>
              <p class="text-slate-600 text-sm">Preview the extracted frames and download individual images or grab all frames in a single ZIP archive.</p>
            </div>
          </div>
        </div>
      </section>

      {/* Features */}
      <section class="space-y-6">
        <h2 class="text-3xl font-bold text-slate-900">Why Choose Our Client-Side Video Frame Extractor?</h2>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="w-6 h-6 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-slate-700"><strong>Zero Server Uploads:</strong> Complete privacy since video bytes never leave your browser.</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-6 h-6 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-slate-700"><strong>Full Source Resolution:</strong> Image frames are extracted at the native width and height of the video.</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-6 h-6 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-slate-700"><strong>Custom Frame Rates:</strong> Choose between 1 FPS, 5 FPS, custom intervals, or every single keyframe.</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-6 h-6 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-slate-700"><strong>Batch ZIP Download:</strong> Effortlessly archive hundreds of frames in seconds.</span>
          </li>
        </ul>
      </section>

      {/* FAQ */}
      <section class="space-y-6">
        <h2 class="text-3xl font-bold text-slate-900">Frequently Asked Questions (FAQ)</h2>
        <div class="space-y-4">
          <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200">
            <h3 class="font-bold text-slate-900 mb-2">Is my video uploaded to any server?</h3>
            <p class="text-slate-600">No. All extraction is done 100% locally inside your web browser using HTML5 Canvas APIs.</p>
          </div>
          <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200">
            <h3 class="font-bold text-slate-900 mb-2">What is the maximum file size supported?</h3>
            <p class="text-slate-600">You can upload videos up to 100MB to maintain optimal browser memory performance.</p>
          </div>
          <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200">
            <h3 class="font-bold text-slate-900 mb-2">Can I extract images in PNG or WebP instead of JPG?</h3>
            <p class="text-slate-600">Yes, you can toggle between JPG, PNG, and WebP formats before initiating extraction.</p>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>
